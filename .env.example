# ========================================================
# TradeAgent 环境变量模板（示例配置，无任何真实生产密钥）
# 复制为 .env 使用，禁止将带真实密码的 .env 提交至 Git 仓库
# ========================================================

# 后端端口
SERVER_PORT=48050

# 数据库连接（本地或 Docker 容器）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=trade_agent_db
MYSQL_USER=root
MYSQL_PASSWORD=root_password_placeholder

# Redis 缓存
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Milvus 向量库
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530

# 演示用大模型 API 配置（支持 DeepSeek / 豆包 / Qwen / OpenAI 统一协议）
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=sk-demo-placeholder-replace-with-your-key
AI_DEFAULT_CHAT_MODEL=deepseek-chat
AI_DEFAULT_VISION_MODEL=doubao-vision-pro

# 阿里百炼 DashScope（Embedding / 视觉 OCR / RAG 评测出题；未配置时相关能力会明确报错）
DASHSCOPE_API_KEY=

# 后端历史摘要模型（独立于浏览器模型设置；需注入后端启动进程，Spring不会自动读取根目录.env）
SUMMARY_API_KEY=
SUMMARY_BASE_URL=https://api.deepseek.com/v1
SUMMARY_MODEL=deepseek-chat

# 飞书开放平台（可选测试）
FEISHU_APP_ID=cli_demo_placeholder
FEISHU_APP_SECRET=sec_demo_placeholder

# 阿里云 OSS 云端归档（可选）
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET_NAME=life-agent-imgsearch
ALIYUN_OSS_ENDPOINT=oss-cn-guangzhou.aliyuncs.com
